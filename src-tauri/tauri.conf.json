{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeAgent",
  "version": "0.1.0",
  "identifier": "local.codeagent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "CodeAgent",
      "width": 1280,
      "height": 860,
      "minWidth": 900,
      "minHeight": 640,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false
  }
}
